# Copy this file to .env and change the values. Docker Compose reads .env automatically.
LMS_SECRET_KEY=change-me-in-production
# 1 = reload the server when code changes (development only, never in a demo
# that other people can reach: the debugger can run code)
LMS_DEBUG=0
# Optional settings (defaults are in README.md)
# LMS_AVATAR_DIR=instance/avatars
# LMS_EBOOK_DIR=instance/ebooks
# LMS_BACKUP_DIR=instance/backups
# LMS_BACKUP_COPY_DIR=instance/backups_copy
# LMS_BCRYPT_ROUNDS=12
# LMS_SESSION_COOKIE_SECURE=0
# HTTPS (NFR-SEC-02). With Docker use the /app/certs paths; without Docker
# use certs/cert.pem and certs/key.pem
# LMS_SSL_CERT=/app/certs/cert.pem
# LMS_SSL_KEY=/app/certs/key.pem
